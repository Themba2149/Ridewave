# Copy to .env in the project root:  Copy-Item .env.example .env
# Never commit .env. Never put server secrets in VITE_ variables.

# ---- Backend ----
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Path is relative to apps/api/prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
SESSION_COOKIE_NAME=ridewave.sid
# Private folder for uploaded driver documents (outside any public directory). Default: apps/api/storage
# STORAGE_DIR=
LOG_LEVEL=info

# Integrations. "dev" adapters are local simulations, not real services.
MAP_PROVIDER=dev
MAP_API_KEY=
PAYMENT_PROVIDER=dev
PAYMENT_API_KEY=
EMAIL_PROVIDER=dev
EMAIL_API_KEY=

# ---- Frontend (public values only) ----
# Leave empty in development: Vite proxies /api to the backend.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:4000
